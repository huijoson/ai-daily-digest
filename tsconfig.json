{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "src/client/supabase.ts",
    "src/client/data.ts",
    "src/client/push.ts"
  ],
  "extends": "expo/tsconfig.base"
}
